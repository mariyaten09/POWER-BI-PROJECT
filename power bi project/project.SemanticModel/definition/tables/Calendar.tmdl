	column Weekday
		lineageTag: 3ad3ab6e-bb3a-41be-bdb1-165f67cce249
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]
		sortByColumn: WeekdayNo

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				CALENDAR(
				DATE(YEAR(MIN(bikeshare_trips[start_date])), 1, 1),
				DATE(YEAR(MAX(bikeshare_trips[start_date])), 12, 31)
				),
				"Year", YEAR([Date]),
				"MonthNo", MONTH([Date]),
				"Month", FORMAT([Date], "MMMM"),
				"YearMonth", FORMAT([Date], "YYYY-MM"),
				"Quarter", "Q" & FORMAT([Date], "Q"),
				"YearQuarter", FORMAT([Date], "YYYY") & " Q" & FORMAT([Date], "Q"),
				"WeekdayNo", WEEKDAY([Date], 2),
				"Weekday", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = feeabefa1f234d08b80ce5befe7eb262

