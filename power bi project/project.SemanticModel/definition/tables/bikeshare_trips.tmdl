table bikeshare_trips
	lineageTag: bde41038-f918-4f82-b247-2fa1bfcaad0f

	measure 'Trips Previous Month' =
			
			CALCULATE(
			    [Trips],
			    DATEADD(
			        Calendar[Date],
			        -1,
			        MONTH
			    )
			)
		formatString: 0
		lineageTag: 1a05b3d3-11ea-4950-b6de-1ef198a63624

	measure 'MoM Growth %' =
			
			DIVIDE(
			    [Trips] - [Trips Previous Month],
			    [Trips Previous Month]
			)
		lineageTag: 2197c23b-f918-4214-86f5-3d1bddec650c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trips Previous Quarter' =
			
			CALCULATE(
			    [Trips],
			    DATEADD(
			        Calendar[Date],
			        -1,
			        QUARTER
			    )
			)
		formatString: 0
		lineageTag: 73baf5f7-3061-40c3-8a99-c9c8478fa627

	measure 'QoQ Growth %' =
			
			DIVIDE(
			    [Trips] - [Trips Previous Quarter],
			    [Trips Previous Quarter]
			)
		lineageTag: 8b1b6f3a-f42f-49cd-b7ef-8e6272624315

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trips Previous Year' =
			
			CALCULATE(
			    [Trips],
			    DATEADD(
			        Calendar[Date],
			        -1,
			        YEAR
			    )
			)
		formatString: 0
		lineageTag: a4006954-8325-4207-9aa0-b36ac230a11d

	measure 'YoY Growth %' =
			
			DIVIDE(
			    [Trips] - [Trips Previous Year],
			    [Trips Previous Year]
			)
		lineageTag: 0fe06a31-eb99-4b91-952a-839e5a15a7a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Trips =
			
			COUNTROWS(bikeshare_trips)
		formatString: 0
		lineageTag: 7bc97f4a-2373-4187-bcf7-5ef11b04b21d

	measure 'AVG DAILY TRIPS' =
			
			AVERAGEX(
			    VALUES(Calendar[Date]),
			    [Trips]
			)
		lineageTag: dd61cf32-6b7f-4bd0-aef5-6de1a667b2dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Trip Duration (min)' =
			
			DIVIDE(
			    AVERAGE(bikeshare_trips[duration_sec]),
			    60
			)
		lineageTag: 822bf3ab-ce0c-4bfc-8deb-d340e6beeb93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trip Share %' =
			
			DIVIDE(
			    [Trips],
			    CALCULATE(
			        [Trips],
			        REMOVEFILTERS(bikeshare_trips[subscriber_type])
			    )
			)
		lineageTag: 6686d6df-788f-4fd6-b0da-e540f7173d92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

