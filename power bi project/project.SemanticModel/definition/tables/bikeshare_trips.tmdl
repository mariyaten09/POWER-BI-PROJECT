	column StartDate =
			
			DATE(
			    YEAR(bikeshare_trips[start_date]),
			    MONTH(bikeshare_trips[start_date]),
			    DAY(bikeshare_trips[start_date])
			)
		formatString: General Date
		lineageTag: 7b7b5e4d-d2eb-4487-8da8-12b80917bb76
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Start Hour' =
			
			HOUR(bikeshare_trips[start_date])
		formatString: 0
		lineageTag: a0fb6579-d7c9-4d2e-88cf-fe5d2cc718c0
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Route =
			
			bikeshare_trips[start_station_name]
			& " → " &
			bikeshare_trips[end_station_name]
		lineageTag: 5b604f63-68e4-4fa1-8800-5900cbf8cbae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age at Trip' =
			
			YEAR(bikeshare_trips[start_date])
			    - bikeshare_trips[member_birth_year]
		formatString: 0
		lineageTag: 36304f05-b66b-4ab9-8452-ec4ca6c9bae3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Group' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(bikeshare_trips[Age at Trip]), BLANK(),
			    bikeshare_trips[Age at Trip] < 25, "<25",
			    bikeshare_trips[Age at Trip] < 35, "25-34",
			    bikeshare_trips[Age at Trip] < 45, "35-44",
			    bikeshare_trips[Age at Trip] < 55, "45-54",
			    "55+"
			)
		lineageTag: 09911c1a-fc51-4ce4-b37a-e73df890db5d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition bikeshare_trips = m
		mode: import
		source =
				let
				    Источник = GoogleBigQuery.Database([Implementation="2.0"]),
				    #"bigquery-public-data_Database" = Источник{[Name="bigquery-public-data",Kind="Database"]}[Data],
				    san_francisco_bikeshare_Schema = #"bigquery-public-data_Database"{[Name="san_francisco_bikeshare",Kind="Schema"]}[Data],
				    bikeshare_trips_Table = san_francisco_bikeshare_Schema{[Name="bikeshare_trips",Kind="Table"]}[Data]
				in
				    bikeshare_trips_Table

	annotation PBI_ResultType = Exception

