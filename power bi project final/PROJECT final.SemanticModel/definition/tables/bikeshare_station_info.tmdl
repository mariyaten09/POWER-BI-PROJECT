table bikeshare_station_info
	lineageTag: c65626b7-ce35-4bca-86b4-d602b13fd3f1

	measure 'Avg Trips per Station' =
			
			AVERAGEX(
			    ALLSELECTED(bikeshare_station_info[name]),
			    [Trips]
			)
		lineageTag: 6143b15e-2fc7-4f43-9156-1436ce29d567

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Station Utilization' =
			
			DIVIDE(
			    [Trips],
			    [Avg Trips per Station]
			)
		lineageTag: 041ea922-692d-477e-a8f1-c541b430d753

		annotation PBI_FormatHint = {"isGeneralNumber":true}

